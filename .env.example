# Copy to .env.local and fill in.

# Dropbox — create an app at https://www.dropbox.com/developers/apps
# with the files.metadata.read and files.content.read scopes, then
# generate an access token on the app's settings page.
DROPBOX_ACCESS_TOKEN=

# Folder to scan for photos. Leave empty to scan your whole Dropbox,
# or point it at your camera roll, e.g. "/Camera Uploads".
DROPBOX_PHOTOS_PATH=

# How close (km) a photo's GPS must be to the trip location to match.
PHOTO_MATCH_RADIUS_KM=100
