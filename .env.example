# Copy to .env.local and fill in.

# Login password. REQUIRED for any public deployment (e.g. Vercel) — every
# page and API route is locked behind it once set. Leave empty to run the app
# open on localhost.
AUTH_PASSWORD=

# Optional: secret for signing session cookies. If empty, sessions are signed
# with a key derived from AUTH_PASSWORD (changing the password then logs
# everyone out). Set to a long random string to decouple the two.
AUTH_SECRET=

# Dropbox — create an app at https://www.dropbox.com/developers/apps with the
# files.metadata.read and files.content.read scopes, add
# http://localhost:3000/api/dropbox/callback as an OAuth 2 redirect URI, and
# paste the App key here. Then click "Connect Dropbox" on the Settings page —
# a one-time step; the app stays connected via a refresh token after that.
DROPBOX_APP_KEY=

# Optional: only needed if your Dropbox app is configured as a confidential
# client. With PKCE (the default flow here) you can leave it empty.
DROPBOX_APP_SECRET=

# Legacy alternative: a static short-lived access token. Only used when no
# OAuth connection exists. Prefer the Connect flow above.
DROPBOX_ACCESS_TOKEN=

# Folder to scan for photos. Leave empty to scan your whole Dropbox,
# or point it at your camera roll, e.g. "/Camera Uploads".
DROPBOX_PHOTOS_PATH=

# How close (km) a photo's GPS must be to the trip location to match.
PHOTO_MATCH_RADIUS_KM=100
